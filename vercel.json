{
  "crons": [
    {
      "path": "/api/scan",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/radar",
      "schedule": "0 5 * * *"
    }
  ],
  "functions": {
    "api/search.js": {
      "maxDuration": 15
    },
    "api/radar.js": {
      "maxDuration": 25
    },
    "api/scan.js": {
      "maxDuration": 60
    },
    "api/deals.js": {
      "maxDuration": 10
    },
    "api/subscribe.js": {
      "maxDuration": 15
    },
    "api/photo.js": {
      "maxDuration": 20
    },
    "api/igtrigger.js": {
      "maxDuration": 15
    },
    "api/journal.js": {
      "maxDuration": 10,
      "includeFiles": "index.html"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "media": false
    }
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/journal?sitemap=1"
    },
    {
      "source": "/journal",
      "destination": "/api/journal?lang=fr"
    },
    {
      "source": "/journal/:id",
      "destination": "/api/journal?lang=fr&id=:id"
    },
    {
      "source": "/:lang(en|es|de|it|pt|ru|zh|ar|ja|ko|hi)/journal",
      "destination": "/api/journal?lang=:lang"
    },
    {
      "source": "/:lang(en|es|de|it|pt|ru|zh|ar|ja|ko|hi)/journal/:id",
      "destination": "/api/journal?lang=:lang&id=:id"
    }
  ]
}
