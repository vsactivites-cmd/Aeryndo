{
  "crons": [
    { "path": "/api/radar", "schedule": "0 5 * * *" }
  ],
  "functions": {
    "api/search.js": { "maxDuration": 15 },
    "api/radar.js": { "maxDuration": 25 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }]
    }
  ]
}
